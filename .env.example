# Postgres container credentials (used by docker-compose.yml and to build DATABASE_URL below)
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=ticketing
POSTGRES_DB=ticketing
POSTGRES_PORT=5433

# Connection string used by Prisma and the app. Keep it in sync with the POSTGRES_* values above.
DATABASE_URL="postgresql://ticketing:ticketing@localhost:5433/ticketing?schema=public"

# Port the NestJS HTTP server listens on
PORT=3000
